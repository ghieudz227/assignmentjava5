ntainer__game__play__game .step__container__game__play__game__rotate:nth-child(5){animation:run 4.8s linear;animation-iteration-count:infinite}#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__game .step__container__game__play__game__rotate:nth-child(6){animation:run 6.05s linear;animation-iteration-count:infinite}#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__box{position:absolute;bottom:0}#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__box img{width:81.8%;margin:auto;display:block}@-webkit-keyframes rotation{from{-webkit-transform:rotate(0deg)}to{-webkit-transform:rotate(-360deg)}}@-webkit-keyframes run{0%{bottom:-20%}25%{bottom:45%;transform:rotate(180deg)}50%{bottom:75%;transform:rotate(360deg)}100%{bottom:-20%;transform:rotate(450deg)}}@media only screen and (max-width:640px){#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__box img{width:100%}#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__game .step__container__game__play__game__rotate{width:21%}#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__game .step__container__game__play__game__rotate:nth-child(1){left:7%}#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__game .step__container__game__play__game__rotate:nth-child(2){left:41%}#game .step .step__container .step__container__game .step__container__game__right .step__container__game__play__game .step__container__game__play__game__rotate:nth-child(3){left:76%}}.ffi {
    width: 900px;
    margin: auto;
}


    .ffi .card-title {
        display: block;
        height: 120px;
    }

        .ffi .card-title img {
            display: block;
            width: auto !important;
            height: auto;
        }

    .ffi .card-container {
        width: 600px;
        max-height: 290px;
        overflow: hidden;
        display: grid;
        grid-auto-rows: minmax(min-content,max-content);
        grid-template-columns: repeat(4,minmax(0,3fr));
        margin: auto;
        grid-gap: 7px;
    }

        .ffi .card-container .card-game {
            border-radius: 5px;
            overflow: hidden;
            cursor: pointer;
        }

            .ffi .card-container .card-game .inner-card {
                width: 140px;
                height: 140px;
                position: relative;
                margin: auto;
            }

                .ffi .card-container .card-game .inner-card .front-card {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    backface-visibility: hidden;
                    transform: rotateX(0deg);
                    transition: 0.5s;
                }

                .ffi .card-container .card-game .inner-card.opened .front-card, .ffi .card-container .card-game .inner-card.opening .front-card {
                    transform: rotateX(-180deg);
                }

                .ffi .card-container .card-game .inner-card .back-card {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    backface-visibility: hidden;
                    transform: rotateX(180deg);
                    transition: 0.5s;
                }

                .ffi .card-container .card-game .inner-card.opened .back-card, .ffi .card-container .card-game .inner-card.opening .back-card {
                    transform: rotateX(0deg);
                }


                .ffi .card-container .card-game .inner-card img {
                    max-width: 100%;
                }

div#btn-next, div#text-warning {
    position: absolute;
    display: none;
    bottom: 17px;
    left: 0;
    right: 0;
    margin: auto;
    cursor: pointer;
}

    div#btn-next img {
        max-width: 200px;
    }

div#game-overlay {
    display: none;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 1;
    background-color: rgba(0,0,0,.4);
}

div#box-warning {
    display: none;
    max-width: 100%;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    clear: both;
    margin: auto;
    overflow: hidden;
    width: 350px;
    background-color: transparent;
    padding: 30px;
    border-radius: 20px;
    font-size: 20px;
    line-height: 24px;
    box-sizing: border-box;
    z-index: 1;
}

    div#box-warning #noti-btn {
        cursor: pointer;
        max-width: 200px;
        margin-top: 15px;
    }

#noti-img {
    cursor: pointer;
}


@media only screen and (max-width: 640px) {
    .ffi {
        width: 100%;
        margin: auto;
    }

        .ffi .card-title {
            height: 30vw;
        }

        .ffi .card-container {
            width: 70%;
            height: 137vw;
            max-height: 137vw;
            overflow: hidden;
            display: grid;
            grid-auto-rows: minmax(min-content,max-content);
            grid-template-columns: repeat(2,minmax(0,3fr));
            margin: auto;
            grid-gap: 7px;
        }

            .ffi .card-container .card-game .inner-card {
                width: 33vw;
                height: 33vw;
                position: relative;
                margin: auto;
            }
}

    </style>
